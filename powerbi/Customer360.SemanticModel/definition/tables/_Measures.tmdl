table _Measures
	isHidden
	lineageTag: b2c94dfe-3fb1-476f-ae33-7948d184fd09

	measure 'Total Revenue' = SUM ( fact_sales[sales_value] )
		formatString: #,##0.00
		displayFolder: 01 Executive
		lineageTag: 1ab6189b-a540-4dbd-8bbe-48c3e31c948a

	measure Baskets = DISTINCTCOUNT ( fact_sales[basket_id] )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: bb6b2915-d0d0-47e6-9d60-c79dcb39c43f

	measure 'Active Customers' = DISTINCTCOUNT ( fact_sales[household_id] )
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 4d24dd61-f6dd-44fa-95fd-bc57a86aeddc

	measure 'Average Order Value' = DIVIDE ( [Total Revenue], [Baskets] )
		formatString: #,##0.00
		displayFolder: 01 Executive
		lineageTag: f6d69ceb-a92d-4aaf-9a39-9985cc8cee01

	measure 'Purchase Frequency' = DIVIDE ( [Baskets], [Active Customers] )
